# OAuth 2.0 user-context Bearer token (PKCE).
# Scopes: tweet.read tweet.write users.read dm.read dm.write like.write
#         bookmark.read bookmark.write tweet.moderate.write media.write
#         follows.read offline.access
# Auth URL https://x.com/i/oauth2/authorize
# Token URL https://api.x.com/2/oauth2/token
# PKCE S256; X rejects client_secret_post.
X_ACCESS_TOKEN=

# HTTP mode only.
PORT=3333
HOST=127.0.0.1
MCP_PATH=/mcp

# Set 1 to skip confirm=true on writes. Never set this in production.
X_ORGANIC_ALLOW_UNCONFIRMED=0
